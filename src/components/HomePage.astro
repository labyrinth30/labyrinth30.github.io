---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import Activities from './Activities.astro';
import { getEditionProjects, type Edition } from '../lib/editions';
type Props = { readonly edition: Edition };
const { edition } = Astro.props;
const projects = await getEditionProjects(edition);
---
<BaseLayout title="백엔드 개발자 포트폴리오" edition={edition}>
<section class="hero shell"><div class="hero-top"><span class="eyebrow">BACKEND DEVELOPER · PORTFOLIO</span><span class="mono hero-year">2026</span></div>
<h1>정합성과 안정성을<br />먼저 생각합니다.</h1>
<div class="hero-bottom"><p>NestJS로 결제와 비동기 작업을 다뤄온<br class="desktop-break" /> 백엔드 개발자 <strong>이윤하</strong>입니다.</p><a href="mailto:younha0088@gmail.com" class="text-link">younha0088@gmail.com <span aria-hidden="true">↗</span></a></div></section>
<section id="projects" class="projects-section shell"><div class="section-heading"><h2>프로젝트</h2></div><div class="project-grid">{projects.map(({entry, number})=><ProjectCard project={entry} number={number} edition={edition}/>)}</div></section>
<Activities />
</BaseLayout>
