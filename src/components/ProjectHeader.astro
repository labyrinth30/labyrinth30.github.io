---
import Sentences from './Sentences.astro';
import type { CollectionEntry } from 'astro:content';
type Props = {readonly project: CollectionEntry<'projects'>; readonly number: string};
const {project, number} = Astro.props;
const p=project.data;
---
<header class="project-header">
<div class="eyebrow">PROJECT {number} / {p.category}</div>
<h1>{p.name}<span>{p.tagline}</span></h1>
<p class="project-description"><Sentences text={p.description}/></p>
<dl class="project-meta"><div><dt>ROLE</dt><dd>{p.role}</dd></div><div><dt>PERIOD</dt><dd>{p.period}</dd></div><div><dt>STACK</dt><dd>{p.stack.join(' · ')}</dd></div></dl>
<p class="project-scope"><Sentences text={`${p.scope} 사례의 테스트 건수와 측정값은 당시 PR·개발 기록 기준입니다.`}/></p>
{p.links.length>0 && <p class="project-links">{p.links.map(link=><a class="text-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</p>}
</header>
